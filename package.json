{
  "name": "unicode-sprite",
  "version": "0.1.0",
  "description": "Draw small pixel-art sprites that render in the terminal with Unicode block characters and 24-bit color.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "unicode-sprite": "./dist/cli/index.js",
    "usprite": "./dist/cli/index.js"
  },
  "files": ["dist", "examples", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "commander": "^13.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
